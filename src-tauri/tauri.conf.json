{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MD Viewer",
  "version": "1.2.0",
  "identifier": "com.local.mdviewer",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MD 阅览 · 本地 Markdown 查看器",
        "width": 1380,
        "height": 880,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown 文档",
        "description": "用 MD 阅览查看与编辑",
        "role": "Viewer"
      }
    ]
  }
}
